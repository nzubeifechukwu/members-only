<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Members Only</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <% if (user) { %> <% if (user.is_member) { %>
    <header>
      <h1 class="member">Members Only</h1>
    </header>
    <main class="member-confirmed">
      <div>
        <h2>You're in, <%= user.first_name %></h2>
        <div class="create-post">
          <a href="/member/<%= user.user_id %>/create">Create Post</a>
        </div>
      </div>
      <section class="messages">
        <% if (messages.length) {%> <% messages.forEach((message) => { %>
        <article>
          <h3><%= message.title %></h3>
          <p>
            At <%= message.timestamp %>,
            <strong><%= message.first_name %> <%= message.last_name %></strong>
            wrote:
          </p>
          <p><%= message.body %></p>
          <% if (user.is_admin) { %>
          <form action="/<%= message.message_id %>/delete" method="post">
            <button
              type="submit"
              onclick="return confirm('Are you sure you want to delete this message?')"
            >
              Delete
            </button>
          </form>
          <% } %>
        </article>
        <%}); %> <% } %>
      </section>
      <% if (user.is_admin && messages.length) { %>
      <form action="/delete" method="post">
        <div class="delete-all">
          <button
            type="submit"
            onclick="return confirm('Are you sure you want to clear all messages?')"
          >
            Delete All
          </button>
        </div>
      </form>
      <% } %>
      <div class="logout"><a href="/log-out">LOG OUT</a></div>
    </main>
    <% } else { %>
    <header><h1>Members Only</h1></header>
    <main class="member-unconfirmed">
      <h2>WELCOME, <%= user.first_name %></h2>
      <form action="/member/<%= user.user_id %>" method="post" class="member">
        <h3>Enter the secret passcode to see message author details</h3>
        <div>
          <div>
            <label for="passcode"
              >Passcode (hint: a pretty popular, six-letter female name)</label
            >
          </div>
          <input type="password" id="passcode" name="passcode" />
        </div>
        <div><button type="submit">Submit</button></div>
      </form>
      <section class="messages">
        <% if (messages.length) {%> <% messages.forEach((message) => { %>
        <article>
          <h3><%= message.title %></h3>
          <p><%= message.body %></p>
        </article>
        <%}); %> <% } %>
      </section>
      <div class="logout"><a href="/log-out">LOG OUT</a></div>
    </main>
    <% } %> <% } else { %>
    <main class="login">
      <h1>Members Only</h1>
      <h2>Log in</h2>
      <form action="/log-in" method="POST">
        <%- include('partials/userAuthenticationError') %>
        <div>
          <label for="username">Email</label>
          <input id="username" name="username" type="email" />
        </div>
        <div>
          <label for="password">Password</label>
          <input id="password" name="password" type="password" />
        </div>
        <div><button type="submit">Log In</button></div>
      </form>
      <small>Don't have an account? <a href="/sign-up">Sign up</a></small>
    </main>
    <%}%>
    <footer>
      <a href="" target="_blank"><small>&copy; Nzube Ifechukwu</small></a>
    </footer>
  </body>
</html>
