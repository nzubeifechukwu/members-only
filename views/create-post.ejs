<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Post</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Return home</a>
      </nav>
      <h1>Members Only</h1>
    </header>
    <main>
      <h2>Make a Post</h2>
      <%- include('partials/inputValidationErrors') %>
      <form action="/member/<%= id %>/create" method="post">
        <label for="title">Title</label
        ><input
          type="text"
          name="title"
          id="title"
          value="<%= locals.formData ? formData.title : '' %>"
        /><label for="body">Body</label
        ><textarea name="body" id="body" cols="30" rows="5">
<%= locals.formData ? formData.body : '' %></textarea
        >
        <button type="submit">Submit</button>
      </form>
    </main>
    <footer></footer>
  </body>
</html>
